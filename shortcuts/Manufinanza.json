{
  "name": "Manufinanza",
  "minimum_ios_client_version": "900",
  "triggers": [],
  "actions": [
    {
      "step": 1,
      "action": "Menu",
      "question": "",
      "branches": [
        {
          "option": "Income",
          "steps": [
            {
              "step": 2,
              "action": "List",
              "output": "Account",
              "parameters": {
                "Items": [
                  "{{ACCOUNT_1}}",
                  "{{ACCOUNT_2}}",
                  "{{ACCOUNT_3}}"
                ]
              }
            },
            {
              "step": 3,
              "action": "Choose from list",
              "parameters": {
                "ChooseFromListActionPrompt": "Select an account",
                "Input": "{{Account}}"
              }
            },
            {
              "step": 4,
              "action": "Ask for input",
              "parameters": {
                "AskActionPrompt": "How much money are you adding?",
                "InputType": "Number"
              }
            },
            {
              "step": 5,
              "action": "Ask for input",
              "parameters": {
                "AskActionPrompt": "Income description",
                "InputType": "Text"
              }
            },
            {
              "step": 6,
              "action": "Text",
              "parameters": {
                "TextActionText": "{{INCOME_CATEGORY_CODE}}"
              }
            },
            {
              "step": 7,
              "action": "Ask for input",
              "parameters": {
                "AskActionPrompt": "Income details",
                "InputType": "Text"
              }
            },
            {
              "step": 8,
              "action": "Text",
              "parameters": {
                "TextActionText": "{\"event_type\": \"gasto_dinamico\",\"client_payload\":{\"cuenta\": \"{{Selected Item}}\",\"lineas\":[{\"categoria\":\"{{Text}}\",\"importe\":\"{{Ask for Input}}\",\"nombre_operacion\": \"{{Ask for Input}}\",\"comentario\":\"{{Ask for Input}}\"}]}}"
              }
            },
            {
              "step": 9,
              "action": "Get contents of URL",
              "parameters": {
                "ShowHeaders": true,
                "HTTPBodyType": "File",
                "HTTPHeaders": {
                  "Authorization": "Bearer {{GITHUB_PAT}}",
                  "Accept": "application/vnd.github+json",
                  "X-GitHub-Api-Version": "2022-11-28"
                },
                "HTTPMethod": "POST",
                "RequestVariable": "{{Text}}",
                "URL": "https://api.github.com/repos/{{GITHUB_OWNER}}/{{GITHUB_REPO}}/dispatches"
              }
            }
          ]
        },
        {
          "option": "Expense",
          "steps": [
            {
              "step": 10,
              "action": "List",
              "output": "Account",
              "parameters": {
                "Items": [
                  "{{ACCOUNT_1}}",
                  "{{ACCOUNT_2}}",
                  "{{ACCOUNT_3}}"
                ]
              }
            },
            {
              "step": 11,
              "action": "Choose from list",
              "parameters": {
                "ChooseFromListActionPrompt": "Select an account",
                "Input": "{{Account}}"
              }
            },
            {
              "step": 12,
              "action": "List",
              "output": "Categories",
              "parameters": {
                "Items": [
                  "{{CATEGORY_1}}",
                  "{{CATEGORY_2}}",
                  "{{CATEGORY_3}}"
                ]
              }
            },
            {
              "step": 13,
              "action": "Choose from list",
              "parameters": {
                "ChooseFromListActionPrompt": "Select an expense category",
                "ChooseFromListActionSelectMultiple": true,
                "Input": "{{Categories}}"
              }
            },
            {
              "step": 14,
              "action": "Menu",
              "question": "Do you have the receipt?",
              "branches": [
                {
                  "option": "Yes",
                  "steps": [
                    {
                      "step": 15,
                      "action": "Take photo",
                      "parameters": {
                        "PhotoCount": 1
                      }
                    },
                    {
                      "step": 16,
                      "action": "Convert image",
                      "parameters": {
                        "ImageCompressionQuality": 0.5133928656578064,
                        "Input": "{{Photo}}"
                      }
                    },
                    {
                      "step": 17,
                      "action": "Random number",
                      "parameters": {
                        "RandomNumberMaximum": "999999999",
                        "RandomNumberMinimum": "100000"
                      }
                    },
                    {
                      "step": 18,
                      "action": "Text",
                      "parameters": {
                        "TextActionText": "{{Random Number}}.jpg"
                      }
                    },
                    {
                      "step": 19,
                      "action": "Text",
                      "parameters": {
                        "TextActionText": "recibos/{{Text}}"
                      }
                    },
                    {
                      "step": 20,
                      "action": "Get contents of URL",
                      "parameters": {
                        "ShowHeaders": true,
                        "HTTPBodyType": "File",
                        "HTTPHeaders": {
                          "apikey": "{{SUPABASE_PUBLISHABLE_KEY}}",
                          "Authorization": "Bearer {{SUPABASE_PUBLISHABLE_KEY}}",
                          "Content-Type": "image/jpeg"
                        },
                        "HTTPMethod": "POST",
                        "RequestVariable": "{{Converted Image}}",
                        "URL": "https://{{SUPABASE_PROJECT_REF}}.supabase.co/storage/v1/object/{{Text}}"
                      }
                    },
                    {
                      "step": 21,
                      "action": "Combine text",
                      "parameters": {
                        "TextCustomSeparator": "','",
                        "TextSeparator": "Custom",
                        "text": "{{Selected Item}}"
                      }
                    },
                    {
                      "step": 22,
                      "action": "Text",
                      "parameters": {
                        "TextActionText": "{\"event_type\": \"gasto_foto\", \"client_payload\": {\"cuenta\": \"{{Selected Item}}\", \"foto_bucket_path\": \"{{Text}}\", \"categorias\": [\"{{Combined Text}}\"]}}"
                      }
                    },
                    {
                      "step": 23,
                      "action": "Get contents of URL",
                      "parameters": {
                        "ShowHeaders": true,
                        "HTTPBodyType": "File",
                        "HTTPHeaders": {
                          "Authorization": "Bearer {{GITHUB_PAT}}",
                          "Accept": "application/vnd.github+json",
                          "X-GitHub-Api-Version": "2022-11-28"
                        },
                        "HTTPMethod": "POST",
                        "RequestVariable": "{{Text}}",
                        "URL": "https://api.github.com/repos/{{GITHUB_OWNER}}/{{GITHUB_REPO}}/dispatches"
                      }
                    }
                  ]
                },
                {
                  "option": "No",
                  "steps": [
                    {
                      "step": 24,
                      "action": "Set variable",
                      "parameters": {
                        "VariableName": "Lines"
                      }
                    },
                    {
                      "step": 25,
                      "action": "Repeat with each",
                      "parameters": {
                        "Input": "{{Selected Item}}"
                      },
                      "branches": [
                        {
                          "option": "Per item",
                          "steps": [
                            {
                              "step": 26,
                              "action": "Ask for input",
                              "parameters": {
                                "AskActionPrompt": "Amount for {{Repeat Item}}",
                                "InputType": "Number"
                              }
                            },
                            {
                              "step": 27,
                              "action": "Ask for input",
                              "parameters": {
                                "AskActionPrompt": "Description for {{Repeat Item}}"
                              }
                            },
                            {
                              "step": 28,
                              "action": "Ask for input",
                              "parameters": {
                                "AskActionPrompt": "Comment or details for {{Repeat Item}}"
                              }
                            },
                            {
                              "step": 29,
                              "action": "Dictionary",
                              "parameters": {
                                "Items": {
                                  "importe": "{{Ask for Input}}",
                                  "categoria": "{{Repeat Item}}",
                                  "nombre_operacion": "{{Ask for Input}}",
                                  "comentario": "{{Ask for Input}}"
                                }
                              }
                            },
                            {
                              "step": 30,
                              "action": "Add to variable",
                              "parameters": {
                                "Input": "{{Dictionary}}",
                                "VariableName": "Lines"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "step": 31,
                      "action": "Combine text",
                      "parameters": {
                        "TextCustomSeparator": ",",
                        "TextSeparator": "Custom",
                        "text": "{{Lines}}"
                      }
                    },
                    {
                      "step": 32,
                      "action": "Text",
                      "parameters": {
                        "TextActionText": "{\"event_type\": \"gasto_dinamico\", \"client_payload\": {\"cuenta\": \"{{Selected Item}}\", \"lineas\": [{{Combined Text}}]}}"
                      }
                    },
                    {
                      "step": 33,
                      "action": "Get contents of URL",
                      "parameters": {
                        "ShowHeaders": true,
                        "HTTPBodyType": "File",
                        "HTTPHeaders": {
                          "Authorization": "Bearer {{GITHUB_PAT}}",
                          "Accept": "application/vnd.github+json",
                          "X-GitHub-Api-Version": "2022-11-28"
                        },
                        "HTTPMethod": "POST",
                        "RequestVariable": "{{Text}}",
                        "URL": "https://api.github.com/repos/{{GITHUB_OWNER}}/{{GITHUB_REPO}}/dispatches"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}