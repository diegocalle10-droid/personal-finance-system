{
  "name": "Compras",
  "minimum_ios_client_version": "900",
  "triggers": [
    {
      "type": "WFWalletTransactionTrigger",
      "wallet_cards": "{{WALLET_CARDS}}"
    }
  ],
  "actions": [
    {
      "step": 1,
      "action": "List",
      "output": "Account",
      "parameters": {
        "Items": [
          "{{ACCOUNT_1}}",
          "{{ACCOUNT_2}}"
        ]
      }
    },
    {
      "step": 2,
      "action": "Choose from list",
      "parameters": {
        "Input": "{{Account}}"
      }
    },
    {
      "step": 3,
      "action": "List",
      "output": "Categories",
      "parameters": {
        "Items": [
          "{{CATEGORY_1}}",
          "{{CATEGORY_2}}",
          "{{CATEGORY_3}}",
          "{{CATEGORY_4}}"
        ]
      }
    },
    {
      "step": 4,
      "action": "Choose from list",
      "parameters": {
        "ChooseFromListActionSelectMultiple": true,
        "Input": "{{Categories}}"
      }
    },
    {
      "step": 5,
      "action": "Menu",
      "question": "Do you have the receipt?",
      "branches": [
        {
          "option": "Yes",
          "steps": [
            {
              "step": 6,
              "action": "Take photo",
              "parameters": {
                "PhotoCount": 1
              }
            },
            {
              "step": 7,
              "action": "Convert image",
              "parameters": {
                "ImageCompressionQuality": 0.5133928656578064,
                "Input": "{{Photo}}"
              }
            },
            {
              "step": 8,
              "action": "Random number",
              "parameters": {
                "RandomNumberMaximum": "999999999",
                "RandomNumberMinimum": "100000"
              }
            },
            {
              "step": 9,
              "action": "Text",
              "parameters": {
                "TextActionText": "{{Random Number}}.jpg"
              }
            },
            {
              "step": 10,
              "action": "Text",
              "parameters": {
                "TextActionText": "recibos/{{Text}}"
              }
            },
            {
              "step": 11,
              "action": "Get contents of URL",
              "parameters": {
                "ShowHeaders": true,
                "HTTPBodyType": "File",
                "HTTPHeaders": {
                  "apikey": "{{SUPABASE_PUBLISHABLE_KEY}}",
                  "Authorization": "Bearer {{SUPABASE_PUBLISHABLE_KEY}}",
                  "Content-Type": "image/jpeg"
                },
                "HTTPMethod": "POST",
                "RequestVariable": "{{Converted Image}}",
                "URL": "https://{{SUPABASE_PROJECT_REF}}.supabase.co/storage/v1/object/{{Text}}"
              }
            },
            {
              "step": 12,
              "action": "Combine text",
              "parameters": {
                "TextCustomSeparator": "','",
                "TextSeparator": "Custom",
                "text": "{{Selected Items}}"
              }
            },
            {
              "step": 13,
              "action": "Text",
              "parameters": {
                "TextActionText": "{\"event_type\": \"gasto_foto\", \"client_payload\": {\"cuenta\": \"{{Selected Item}}\", \"foto_bucket_path\": \"{{Text}}\", \"categorias\": [\"{{Combined Text}}\"]}}"
              }
            },
            {
              "step": 14,
              "action": "Get contents of URL",
              "parameters": {
                "ShowHeaders": true,
                "HTTPBodyType": "File",
                "HTTPHeaders": {
                  "Authorization": "Bearer {{GITHUB_PAT}}",
                  "Accept": "application/vnd.github+json",
                  "X-GitHub-Api-Version": "2022-11-28"
                },
                "HTTPMethod": "POST",
                "RequestVariable": "{{Text}}",
                "URL": "https://api.github.com/repos/{{GITHUB_OWNER}}/{{GITHUB_REPO}}/dispatches"
              }
            }
          ]
        },
        {
          "option": "No",
          "steps": [
            {
              "step": 15,
              "action": "Set variable",
              "parameters": {
                "VariableName": "Lines"
              }
            },
            {
              "step": 16,
              "action": "Repeat with each",
              "parameters": {
                "Input": "{{Selected Items}}"
              },
              "branches": [
                {
                  "option": "Per item",
                  "steps": [
                    {
                      "step": 17,
                      "action": "Ask for input",
                      "parameters": {
                        "AskActionPrompt": "Amount for {{Repeat Item}}",
                        "InputType": "Number"
                      }
                    },
                    {
                      "step": 18,
                      "action": "Ask for input",
                      "parameters": {
                        "AskActionPrompt": "Expense name for {{Repeat Item}}"
                      }
                    },
                    {
                      "step": 19,
                      "action": "Ask for input",
                      "parameters": {
                        "AskActionPrompt": "Expense comment for {{Repeat Item}}"
                      }
                    },
                    {
                      "step": 20,
                      "action": "Dictionary",
                      "parameters": {
                        "Items": {
                          "importe": "{{Ask for Input}}",
                          "categoria": "{{Repeat Item}}",
                          "nombre_operacion": "{{Ask for Input}}",
                          "comentario": "{{Ask for Input}}"
                        }
                      }
                    },
                    {
                      "step": 21,
                      "action": "Add to variable",
                      "parameters": {
                        "Input": "{{Dictionary}}",
                        "VariableName": "Lines"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "step": 22,
              "action": "Combine text",
              "parameters": {
                "TextCustomSeparator": ",",
                "TextSeparator": "Custom",
                "text": "{{Lines}}"
              }
            },
            {
              "step": 23,
              "action": "Text",
              "parameters": {
                "TextActionText": "{\"event_type\": \"gasto_dinamico\", \"client_payload\": {\"cuenta\": \"{{Selected Item}}\", \"lineas\": [{{Combined Text}}]}}"
              }
            },
            {
              "step": 24,
              "action": "Get contents of URL",
              "parameters": {
                "ShowHeaders": true,
                "HTTPBodyType": "File",
                "HTTPHeaders": {
                  "Authorization": "Bearer {{GITHUB_PAT}}",
                  "Accept": "application/vnd.github+json",
                  "X-GitHub-Api-Version": "2022-11-28"
                },
                "HTTPMethod": "POST",
                "RequestVariable": "{{Text}}",
                "URL": "https://api.github.com/repos/{{GITHUB_OWNER}}/{{GITHUB_REPO}}/dispatches"
              }
            }
          ]
        }
      ]
    }
  ]
}